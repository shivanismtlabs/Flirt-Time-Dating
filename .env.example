# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flirttime_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=true
DB_SSL=false

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_flirttime_2026_change_in_production
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="FlirtTime" <noreply@flirttime.app>
SMTP_SECURE=false

# Apple Sign In Configuration
APPLE_CLIENT_ID=com.flirttime.app
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AWS S3 & Rekognition Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=flirttime-private-media
FACE_SIMILARITY_THRESHOLD=85.0
# Firebase Phone OTP
# Web API key from Firebase console > Project settings > General.
# When this is set, phone OTP SMS is sent and checked by Firebase Auth.
# Enable the Phone provider under Authentication > Sign-in method.
# The mobile app may also send playIntegrityToken (Android) or iosReceipt and iosSecret (iOS).
# iOS sends must include X-Ios-Bundle-Identifier. The API uses APPLE_BUNDLE_ID
# (default com.flirttime.app) unless the client sends iosBundleId.
# iOS first exchanges the APNs device token at POST /auth/phone/ios/verify-client.
# Pass isSandbox true for debug builds. Then request-otp uses that receipt plus the silent-push secret.
FIREBASE_WEB_API_KEY=

# Real SMS Gateway Configuration (used only when FIREBASE_WEB_API_KEY is empty)
# 1. Fast2SMS (India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key

# 2. 2Factor.in (India - https://2factor.in)
TWO_FACTOR_API_KEY=your_2factor_api_key

# 3. Twilio (Global - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Apple PushKit VoIP (background / locked / killed incoming audio and video calls)
# APNS_KEY_ID must be an Apple Push Notifications key (Auth Key .p8), not Sign in with Apple.
# Topic must be the iOS bundle id + `.voip`.
APNS_ENABLED=true
APNS_KEY_ID=MHPU76K3XJ
APNS_TEAM_ID=PQ3L2P67J5
APNS_VOIP_TOPIC=com.flirttime.app.voip
APNS_PRODUCTION=false
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Agora RTC Video Calling Configuration
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_EXPIRATION_SECONDS=3600
AGORA_RINGING_EXPIRATION_SECONDS=60


