    {
      "name": "Sign in with Apple",
      "item": [
        {
          "name": "Apple Authentication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identityToken\": \"<APPLE_IDENTITY_TOKEN>\",\n  \"authorizationCode\": \"<OPTIONAL_CODE>\",\n  \"nonce\": \"<OPTIONAL_NONCE>\",\n  \"user\": {\n    \"name\": {\n      \"firstName\": \"Mike\",\n      \"lastName\": \"Hussey\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/apple",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "apple"]
            }
          },
          "response": []
        }
      ]
    },
    {
