    {
      "name": "Discovery Feed",
      "item": [
        {
          "name": "Get Discovery People (Default Feed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/discovery/people?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "discovery", "people"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Returns candidate dating profiles filtered by sexual/gender preferences with age, city, distanceKm, sharedInterests, interestTags, and vibeScore."
          },
          "response": []
        },
        {
          "name": "Get Discovery People (Filtered by Interest - e.g. Gaming)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/discovery/people?interestId=<INTEREST_ID>&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "discovery", "people"],
              "query": [
                {
                  "key": "interestId",
                  "value": "<INTEREST_ID>",
                  "description": "UUID of interest category (e.g. Gaming, Cooking)"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Filters discovery candidates who possess the specified interest (e.g. Showing 🎮 Gaming ⓧ) without altering user's own onboarding interests."
          },
          "response": []
        },
        {
          "name": "Discovery Action: Like (Interested)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"<TARGET_USER_ID>\",\n  \"action\": \"like\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/discovery/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "discovery", "actions"]
            },
            "description": "Submits a Like (Interested) swipe on target discovery candidate. Returns isMatched=true and matchId if reciprocal like exists."
          },
          "response": []
        },
        {
          "name": "Discovery Action: Nope (Not My Vibe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"<TARGET_USER_ID>\",\n  \"action\": \"nope\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/discovery/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "discovery", "actions"]
            },
            "description": "Submits a Nope (Not my vibe / Not interested) swipe on target discovery candidate. Never creates a match."
          },
          "response": []
        },
        {
          "name": "Discovery Action: Super Like (Connect)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"<TARGET_USER_ID>\",\n  \"action\": \"super_like\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/discovery/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "discovery", "actions"]
            },
            "description": "Submits a Super Like (Connect star button) swipe on target candidate. Returns match if reciprocal like/super-like exists."
          },
          "response": []
        },
        {
          "name": "Get Other User Profile Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/:userId/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", ":userId", "profile"],
              "variable": [
                {
                  "key": "userId",
                  "value": "<TARGET_USER_ID>",
                  "description": "UUID of the user whose profile is being viewed"
                }
              ]
            },
            "description": "Retrieves the target user's full profile detail screen (e.g. Meera, 26) including profile photo, verified status, city, distance, Why This Vibe? score and explanation, bio, voice intro audio, moments gallery, interests, shared interests, and bottom action state (myAction, isMatched, canConnect)."
          },
          "response": []
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Inappropriate behavior\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/:userId/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", ":userId", "block"],
              "variable": [
                {
                  "key": "userId",
                  "value": "<TARGET_USER_ID>",
                  "description": "UUID of the user to block"
                }
              ]
            },
            "description": "Blocks target user. Excludes target from discovery feed, prevents swipes/likes/connections, and restricts mutual profile visibility."
          },
          "response": []
        },
        {
          "name": "Report User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"fake_profile\",\n  \"description\": \"This profile appears to be using someone else's photos.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/:userId/report",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", ":userId", "report"],
              "variable": [
                {
                  "key": "userId",
                  "value": "<TARGET_USER_ID>",
                  "description": "UUID of the user to report"
                }
              ]
            },
            "description": "Reports target user for policy violations. Supported reasons: fake_profile, harassment, inappropriate_content, spam, scam, underage, other."
          },
          "response": []
        }
      ]
    },
    {
