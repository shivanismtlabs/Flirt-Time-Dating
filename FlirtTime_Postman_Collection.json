    },
    {
      "name": "Face Recognition & Gesture Upload",
      "item": [
        {
          "name": "Gesture Upload (Laravel-Compatible Face Verification)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "selfie_image",
                  "type": "file",
                  "src": [],
                  "description": "User selfie photo (JPEG, PNG, WebP <= 5MB)"
                },
                {
                  "key": "verification_type",
                  "value": "gesture",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/gesture-upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gesture-upload"]
            },
            "description": "Uploads user selfie and compares against registered primary profile photo using AWS Rekognition."
          },
          "response": []
        },
        {
          "name": "Face Verification Upload (Alternative Alias)",
