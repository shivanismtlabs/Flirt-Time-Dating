{
  "name": "flirt-time-backend",
  "version": "1.0.0",
  "description": "Node.js Express PostgreSQL Sequelize REST API Backend with TypeScript and JWT Auth",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest --runInBand",
    "seed:discovery": "ts-node src/scripts/seedDiscovery.ts",
    "seed:coin-packages": "ts-node src/scripts/seedCoinPackages.ts",
    "seed:subscriptions": "ts-node src/scripts/seedSubscriptions.ts",
    "migrate:chat": "ts-node src/scripts/migrateChatTables.ts",
    "grant:subscription": "ts-node src/scripts/grantSubscription.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "sequelize",
    "typescript",
    "jwt",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@parse/node-apn": "^6.5.0",
    "@types/nodemailer": "^8.0.2",
    "agora-token": "^2.0.7",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
